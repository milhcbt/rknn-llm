    "import torch\n",
    "\n",
    "# Create a simple tensor\n",
    "message = torch.tensor([72, 101, 108, 108, 111, 32, 87, 111, 114, 108, 100, 33])\n",
    "\n",
    "# Convert ASCII codes back to a string and print\n",
    "print(\"\".join([chr(int(x)) for x in message]))\n"
   ]
